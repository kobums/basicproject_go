# .env 값(DB_HOST / DB_USER / DB_PASSWORD ...)을 make 와 하위 명령(gomachine, docker compose)에 넘긴다.
-include .env
export

APP       := basicproject_go
TAG       ?= latest
IMAGE     ?= $(APP)
# gomachine (make install 하면 ~/bin/buildtool-model, 템플릿은 ~/bin/buildtool/)
BUILDTOOL ?= $(shell command -v buildtool-model 2>/dev/null || echo $(HOME)/bin/buildtool-model)
COMPOSE   ?= docker compose

# gomachine 이 만드는 Go 파일 (첫 줄 "// Code generated by gomachine. DO NOT EDIT.")
GENERATED_DIRS := models controllers/rest router/routers

.PHONY: all gen db-up db-down db-reset run build test vet fmt linux docker docker-up docker-down clean

all: build

# DB(information_schema)를 읽어 model.json 의 테이블 코드를 다시 만든다. make db-up 이 먼저 필요하다.
# 생성 파일은 gofmt 로 정리한다 (다시 만들어도 diff 가 없다).
gen:
	$(BUILDTOOL) . go
	gofmt -w $(GENERATED_DIRS)

db-up:
	$(COMPOSE) up -d db

db-down:
	$(COMPOSE) down

# 볼륨까지 지우고 db/schema.sql 로 다시 만든다.
db-reset:
	$(COMPOSE) down -v
	$(COMPOSE) up -d db

run:
	go run .

build:
	go build -o bin/$(APP) .

test:
	go test ./...

vet:
	go vet ./...

fmt:
	gofmt -l -w .

linux:
	CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o bin/$(APP).linux .

docker:
	docker build -t $(IMAGE):$(TAG) .

# db + api 컨테이너 (docker-compose.yml 의 api profile)
docker-up:
	$(COMPOSE) --profile api up -d --build

docker-down:
	$(COMPOSE) --profile api down

clean:
	rm -f bin/$(APP) bin/$(APP).linux
