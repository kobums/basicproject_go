# (선택) 예전 방식의 모드별 설정 파일. 환경변수 / .env 가 우선이고, 비어 있는 값만 여기서 채운다.
# cp .env.yml.example .env.yml — .env.yml 은 .gitignore 로 커밋되지 않는다.
version: "1.0.0"

develop:
  port: 8007
  cors: [http://localhost:5173, http://localhost:3000]
  path: ./webdata
  documentRoot: ./dist
  # HS256 서명 키 (32 바이트 이상). JWT_SECRET 환경변수가 있으면 그것을 쓴다.
  jwtSecret: change-me-to-a-random-secret-at-least-32-bytes-long
  log:
    level: debug
    console: true
    web: true
    file: webdata/log/system.log

production:
  port: 8007
  cors: [https://example.com]
  path: ./webdata
  documentRoot: ./dist
  log:
    level: info
    console: true
    web: true
    file: webdata/log/system.log
