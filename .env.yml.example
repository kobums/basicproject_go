version: "1.0.0"

# 실제 설정은 이 파일을 복사해 `.env.yml` 로 만들어 채운다.
# `.env.yml` 은 .gitignore 로 커밋되지 않는다(시크릿 유출 방지).

develop:
  database:
    type: mysql
    host: your-db-host
    port: 3306
    name: your-db-name
    user: your-db-user
    password: your-db-password
  port: 8007
  cors: [http://localhost:9007, http://localhost:5173, http://localhost:3000]
  documentRoot: ./webdata
  path: ./webdata
  # HS256 서명용 비밀키(최소 32바이트). 운영에서는 환경변수/시크릿으로 교체할 것.
  jwtSecret: change-me-to-a-random-secret-at-least-32-bytes-long

production:
  database:
    type: mysql
    host: your-db-host
    port: 3306
    name: your-db-name
    user: your-db-user
    password: your-db-password
  port: 8007
  cors: [https://example.com]
  documentRoot: ./webdata
  path: ./webdata
  jwtSecret: change-me-to-a-random-secret-at-least-32-bytes-long
